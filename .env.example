# Copy to .env.local and fill in. Never commit real values.
# The app and the test suite share this one project (see plan.md D6).

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://rnsrxyjvyvyugbplcxbu.supabase.co
# anon / publishable key — safe for the browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — SERVER ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client ID/secret are NOT set here — they live in
# Supabase -> Authentication -> Providers -> Google.

# --- Paystack (Settings -> API Keys & Webhooks, use the TEST key: sk_test_...) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Mailgun (Sending -> Domains -> sandbox domain) ---
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandboxXXXXXXXX.mailgun.org
MAILGUN_FROM="Coffee Shop <postmaster@sandboxXXXXXXXX.mailgun.org>"
# EU accounts: https://api.eu.mailgun.net
MAILGUN_API_URL=https://api.mailgun.net

# --- Gmail fallback (optional, recommended while Mailgun is on a sandbox domain) ---
# Used only when Mailgun refuses a message, e.g. the sandbox 403 for recipients
# you haven't authorised, so every customer still gets their confirmation.
# Needs 2-Step Verification on the Gmail account, then an App Password from
# https://myaccount.google.com/apppasswords (16 characters; spaces are fine).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Sender name shown in the inbox (default "Coffee Shop")
EMAIL_FROM_NAME=Coffee Shop

# --- Optional ---
# Log level for the JSON server logs: debug | info (default) | warn | error | silent
LOG_LEVEL=info
# Multiplies every rate limit (default 1). The test suite raises it; leave at 1 in production.
RATE_LIMIT_SCALE=1
